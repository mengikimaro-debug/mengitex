rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened global helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Standalone validation blueprint for CloudBackup documents
    function isValidCloudBackup(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 100 &&
             data.deviceModel is string && data.deviceModel.size() >= 1 && data.deviceModel.size() <= 80 &&
             data.encryptedPayload is string && data.encryptedPayload.size() >= 1 && data.encryptedPayload.size() <= 850000 &&
             data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 100000 &&
             data.templateCount is int && data.templateCount >= 0 && data.templateCount <= 10000 &&
             data.contactCount is int && data.contactCount >= 0 && data.contactCount <= 50000 &&
             data.passwordProtected is bool &&
             data.formatVersion is int && data.formatVersion == 1 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Per-user encrypted MengiTex cloud backup snapshots
    match /users/{userId}/cloud_backups/{backupId} {
      allow get: if isOwner(userId) && isValidId(backupId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(backupId) &&
                       incoming().keys().hasAll([
                         'userId', 'label', 'deviceModel', 'encryptedPayload',
                         'messageCount', 'templateCount', 'contactCount',
                         'passwordProtected', 'formatVersion', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'label', 'deviceModel', 'encryptedPayload',
                         'messageCount', 'templateCount', 'contactCount',
                         'passwordProtected', 'formatVersion', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCloudBackup(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(backupId) &&
                       isValidCloudBackup(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action: Rename cloud backup label
                         incoming().diff(existing()).affectedKeys().hasOnly(['label', 'updatedAt'])
                       );

      allow delete: if isOwner(userId) && isValidId(backupId);
    }
  }
}
